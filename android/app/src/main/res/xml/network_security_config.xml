<?xml version="1.0" encoding="utf-8"?>
<!--
  Ollama commonly runs over plaintext HTTP on a LAN address (e.g. http://192.168.x.x:11434)
  or localhost. GitHub and Ollama Cloud are HTTPS. We allow cleartext only so a self-hosted
  Ollama endpoint can be reached; production HTTPS endpoints are unaffected.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
